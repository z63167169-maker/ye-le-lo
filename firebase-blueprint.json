{
  "entities": {
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global storefront configuration, branding, profit defaults, payment accounts, and homepage layout.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 160 },
        "logoUrl": { "type": "string", "maxLength": 300000 },
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "secondaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "whatsappNumber": { "type": "string", "minLength": 7, "maxLength": 25 },
        "storePhone": { "type": "string", "maxLength": 30 },
        "storeEmail": { "type": "string", "maxLength": 120 },
        "businessAddress": { "type": "string", "maxLength": 300 },
        "currency": { "type": "string", "maxLength": 10 },
        "defaultProfit": { "type": "number" },
        "defaultProfitType": { "type": "string", "enum": ["fixed", "percentage"] },
        "autoProfitEnabled": { "type": "boolean" },
        "defaultDeliveryCharge": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "orderConfirmationMessage": { "type": "string", "maxLength": 400 },
        "maintenanceMode": { "type": "boolean" },
        "footerAbout": { "type": "string", "maxLength": 500 },
        "socialLinks": { "type": "object" },
        "paymentMethods": { "type": "object" },
        "banners": { "type": "array" },
        "homepageSections": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "siteName",
        "tagline",
        "primaryColor",
        "secondaryColor",
        "whatsappNumber",
        "defaultProfit",
        "defaultProfitType",
        "autoProfitEnabled",
        "defaultDeliveryCharge",
        "maintenanceMode"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Product category with display order and visibility.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9-]+$" },
        "description": { "type": "string", "maxLength": 240 },
        "imageUrl": { "type": "string", "maxLength": 300000 },
        "visible": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "visible", "sortOrder", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Storefront product with base pricing, automatic/custom profit rules, inventory, and variations.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z0-9-]+$" },
        "sku": { "type": "string", "minLength": 1, "maxLength": 40 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "categoryName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "images": { "type": "array" },
        "purchasePrice": { "type": "number" },
        "basePrice": { "type": "number" },
        "profitMode": { "type": "string", "enum": ["default", "fixed", "percentage", "disabled"] },
        "customProfit": { "type": "number" },
        "discountPercent": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "useDefaultDelivery": { "type": "boolean" },
        "stock": { "type": "number" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "active": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "bestSelling": { "type": "boolean" },
        "latestArrival": { "type": "boolean" },
        "recommended": { "type": "boolean" },
        "salesCount": { "type": "number" },
        "ratingAvg": { "type": "number" },
        "ratingCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "slug",
        "sku",
        "description",
        "categoryId",
        "categoryName",
        "images",
        "purchasePrice",
        "basePrice",
        "profitMode",
        "customProfit",
        "discountPercent",
        "deliveryCharge",
        "useDefaultDelivery",
        "stock",
        "sizes",
        "colors",
        "active",
        "featured",
        "createdAt",
        "updatedAt"
      ]
    },
    "Discount": {
      "title": "Discount",
      "description": "Promotional coupon code.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9_-]+$" },
        "type": { "type": "string", "enum": ["fixed", "percentage"] },
        "value": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "active": { "type": "boolean" },
        "usageCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "type", "value", "minOrderAmount", "active", "usageCount", "createdAt"]
    },
    "UserPublic": {
      "title": "UserPublic",
      "description": "Publicly non-sensitive user profile and wishlist.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "wishlist": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "wishlist", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Customer PII stored in isolated private subcollection.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 400 },
        "city": { "type": "string", "maxLength": 80 },
        "ordersCount": { "type": "number" },
        "totalSpent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "ordersCount", "totalSpent", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order record.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "minLength": 5, "maxLength": 400 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "paymentMethod": { "type": "string", "enum": ["COD", "Easypaisa", "JazzCash"] },
        "orderNotes": { "type": "string", "maxLength": 500 },
        "subtotal": { "type": "number" },
        "deliveryTotal": { "type": "number" },
        "discountCode": { "type": "string", "maxLength": 32 },
        "discountAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "estimatedProfit": { "type": "number" },
        "itemCount": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["New Order", "Pending Confirmation", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderNumber",
        "userId",
        "customerName",
        "phone",
        "address",
        "city",
        "paymentMethod",
        "subtotal",
        "deliveryTotal",
        "discountAmount",
        "totalAmount",
        "estimatedProfit",
        "itemCount",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Line item inside an order subcollection.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "productName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sku": { "type": "string", "maxLength": 40 },
        "imageUrl": { "type": "string", "maxLength": 300000 },
        "size": { "type": "string", "maxLength": 30 },
        "color": { "type": "string", "maxLength": 30 },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "unitProfit": { "type": "number" },
        "lineTotal": { "type": "number" }
      },
      "required": ["orderId", "productId", "productName", "quantity", "unitPrice", "unitProfit", "lineTotal"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "productName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "productName", "userId", "authorName", "rating", "comment", "verified", "createdAt"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Newsletter subscription record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "userId", "createdAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Authoritative admin allowlist keyed by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/storeSettings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store settings and website customization document."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories collection."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Storefront products collection."
    },
    "/discounts/{discountId}": {
      "schema": { "$ref": "#/entities/Discount" },
      "description": "Discount coupon codes keyed by uppercase code."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Non-PII customer profile and wishlist."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Isolated PII customer profile data."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders collection."
    },
    "/orders/{orderId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/OrderItem" },
      "description": "Line items belonging to an order."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product reviews collection."
    },
    "/newsletter/{subscriberId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Newsletter subscribers."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Authorized admin accounts keyed by UID."
    }
  }
}
